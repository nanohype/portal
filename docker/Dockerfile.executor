FROM alpine:3.22

ARG TOFU_VERSION=1.11.0
ARG TERRAGRUNT_VERSION=0.84.0

# Set by BuildKit for the image being built: amd64, arm64, ...
#
# Both downloads below used to name linux_amd64 outright. On a multi-arch build
# that is not a portability nicety — it puts an x86-64 tofu inside the arm64
# image, so the manifest resolves correctly on a Graviton node and the binary
# then fails to exec. Every nanohype cluster defaults to ARM system nodes, so
# the arm64 half of the manifest is the half that actually runs, and a run
# scheduled onto it dies at the first `tofu version` with no plan and no diff.
ARG TARGETARCH

RUN apk add --no-cache \
    ca-certificates \
    git \
    curl \
    unzip \
    bash

# Install OpenTofu
RUN curl -fsSL "https://github.com/opentofu/opentofu/releases/download/v${TOFU_VERSION}/tofu_${TOFU_VERSION}_linux_${TARGETARCH}.zip" \
    -o /tmp/tofu.zip && \
    unzip /tmp/tofu.zip -d /usr/local/bin && \
    rm /tmp/tofu.zip && \
    chmod +x /usr/local/bin/tofu && \
    tofu version

# Install Terragrunt (wraps tofu; workspaces with terragrunt.hcl auto-route here)
RUN curl -fsSL "https://github.com/gruntwork-io/terragrunt/releases/download/v${TERRAGRUNT_VERSION}/terragrunt_linux_${TARGETARCH}" \
    -o /usr/local/bin/terragrunt && \
    chmod +x /usr/local/bin/terragrunt && \
    terragrunt --version

# Create non-root user
RUN addgroup -S tofu && adduser -S tofu -G tofu
USER tofu
WORKDIR /work

ENTRYPOINT ["/bin/sh"]
